<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundled XPC service: the only process that calls the private DictionaryServices API.
	     If a future macOS makes it segfault, this process dies and XiaolaiDict falls back. -->
	<key>CFBundleIdentifier</key>
	<string>com.xiaolaidict.DictionaryService</string>
	<key>CFBundleName</key>
	<string>XiaolaiDictService</string>
	<key>CFBundleExecutable</key>
	<string>XiaolaiDictService</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
	</dict>
</dict>
</plist>
